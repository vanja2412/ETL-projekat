            <component
              refId="Package\Data Flow Task\Citanje iz baze"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
              description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
              name="Citanje iz baze"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement used by the component to extract data."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    i.order_id,
    r.review_id,
    
    -- Svi spremni surogat ključevi iz tvoje ETL baze
    c.customer_sid,
    p.product_sid,
    s.seller_sid,
    
    -- ZAMENA ZA NULL: Ako je review_sid NULL (jer nema recenzije), SQL će ga automatski pretvoriti u -1
    ISNULL(rev.review_sid, -1) AS review_sid, 
    
    -- Mere za cene i poštarinu
    i.price AS product_price,
    i.freight_value,
    
    -- ZAMENA ZA NULL OCENU: Ako nema ocene, stavljamo 0 (kako si ranije planirala)
    ISNULL(r.review_score, 0) AS review_score,
    
    -- Datumi potrebni za računanje ostalih mera u Derived Column
    o.order_approved_at,
    o.order_delivered_customer_date,
    o.order_estimated_delivery_date
FROM dbo.olist_order_items_dataset i
INNER JOIN dbo.olist_orders_dataset o ON i.order_id = o.order_id
LEFT JOIN dbo.olist_order_reviews_dataset r ON i.order_id = r.order_id

-- Povezivanje sa dimenzijama kupca, proizvoda i dobavljača (INNER JOIN)
INNER JOIN [ETL].[dbo].[DimKupac] c ON o.customer_id = c.cusomer_id
INNER JOIN [ETL].[dbo].[DimProizvod] p ON i.product_id = p.product_id
INNER JOIN [ETL].[dbo].[DimDobavljac] s ON i.seller_id = s.seller_id

-- Povezivanje sa dimenzijom recenzije preko LEFT JOIN-a
LEFT JOIN [ETL].[dbo].[DimRecenzija] rev ON r.review_id = rev.review_id

-- Filter za eliminaciju NULL vrednosti isporuke
WHERE o.order_approved_at IS NOT NULL 
  AND o.order_delivered_customer_date IS NOT NULL 
  AND o.order_estimated_delivery_date IS NOT NULL;</property>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">30</property>
                <property
