        <SQLTask:SqlTaskData
          SQLTask:Connection="{E5BDE523-CF67-4C12-9FED-A558DC7212FE}"
          SQLTask:SqlStatementSource="IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM sysobjects&#xA;&#x9;WHERE id = OBJECT_ID(N'FactsPorudžbine'))&#xA;BEGIN&#xA;&#x9;DROP TABLE [dbo].[FactsPorudžbine]&#xA;&#xA;&#x9;CREATE TABLE [dbo].[FactsPorudžbine](&#xA;&#x9;[order_sid] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[order_id] [nvarchar](50) NOT NULL,&#xA;&#x9;[customer_sid] [int] NOT NULL,&#xA;&#x9;[product_sid] [int] NOT NULL,&#xA;&#x9;[time_sid] [int] NOT NULL,&#xA;&#x9;[review_sid] [int],&#xA;&#x9;[seller_sid] [int] NOT NULL,&#xA;&#x9;[number_of_products] [int] NOT NULL,&#xA;&#x9;[product_price] [money] NOT NULL,&#xA;&#x9;[freight_value] [money] NOT NULL,&#xA;&#x9;[total_cost] [money] NOT NULL,&#xA;&#x9;[review_score] [int] NOT NULL,&#xA;&#x9;[delivery_time_needed] [int] NOT NULL,&#xA;&#x9;[delivery_delay] [int] NOT NULL,&#xA;&#x9;[average_score] [float] NOT NULL,&#xA;&#x9;[cost_of_delayed_items] [money] NOT NULL,&#xA;&#x9;[delivery_delay_percentage] [float] NOT NULL,&#xA; CONSTRAINT [PK_FactsPorudžbine] PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[order_sid] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [FK_FactsPorudžbine_DimDobavljac] FOREIGN KEY([seller_sid])&#xA;REFERENCES [dbo].[DimDobavljac] ([seller_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [FK_FactsPorudžbine_DimDobavljac]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [FK_FactsPorudžbine_DimKupac] FOREIGN KEY([customer_sid])&#xA;REFERENCES [dbo].[DimKupac] ([customer_sid])&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [FK_FactsPorudžbine_DimKupac]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [FK_FactsPorudžbine_DimProizvod] FOREIGN KEY([product_sid])&#xA;REFERENCES [dbo].[DimProizvod] ([product_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [FK_FactsPorudžbine_DimProizvod]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [FK_FactsPorudžbine_DimRecenzija] FOREIGN KEY([review_sid])&#xA;REFERENCES [dbo].[DimRecenzija] ([review_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [FK_FactsPorudžbine_DimRecenzija]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [FK_FactsPorudžbine_DimVreme] FOREIGN KEY([time_sid])&#xA;REFERENCES [dbo].[DimVreme] ([time_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [FK_FactsPorudžbine_DimVreme]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine] CHECK  (([delivery_time_needed]&gt;(0)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_2] CHECK  (([average_score]&gt;=(0) AND [average_score]&lt;=(5)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_2]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_3] CHECK  (([cost_of_delayed_items]&gt;(0)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_3]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_4] CHECK  (([delivery_delay_percentage]&gt;=(0) AND [delivery_delay_percentage]&lt;=(100)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_4]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_5] CHECK  (([review_score]&gt;=(0) AND [review_score]&lt;=(5)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_5]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_6] CHECK  (([product_price]&gt;(0)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_6]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_7] CHECK  (([freight_value]&gt;(0)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_7]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_8] CHECK  (([number_of_products]&gt;=(1)))&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_8]&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine]  WITH CHECK ADD  CONSTRAINT [CK_FactsPorudžbine_9] CHECK  (([total_cost]&gt;(0)))&#xA;&#xA;ALTER TABLE [dbo].[FactsPorudžbine] CHECK CONSTRAINT [CK_FactsPorudžbine_9]&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
