        <SQLTask:SqlTaskData
          SQLTask:Connection="{E5BDE523-CF67-4C12-9FED-A558DC7212FE}"
          SQLTask:SqlStatementSource="IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS&#xA;&#x9;WHERE CONSTRAINT_NAME = 'FK_FactsPorudžbine_DimRecenzija')&#xA;BEGIN&#xA;&#x9;ALTER TABLE [dbo].[FactsPorudžbine] DROP CONSTRAINT [FK_FactsPorudžbine_DimRecenzija]&#xA;END&#xA;&#xA;IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM sysobjects&#xA;&#x9;WHERE id = OBJECT_ID(N'DimRecenzija'))&#xA;BEGIN&#xA;&#x9;DROP TABLE [dbo].[DimRecenzija]&#xA;&#x9;&#xA;&#x9;CREATE TABLE [dbo].[DimRecenzija](&#xA;&#x9;[review_sid] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[review_id] [nvarchar](50) NOT NULL,&#xA;&#x9;[review_comment_title] [nvarchar](50) NULL,&#xA;&#x9;[review_comment_message] [nvarchar](250) NULL,&#xA;&#x9;[review_creation_date] [datetime] NULL,&#xA; CONSTRAINT [PK_DimRecenzije] PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[review_sid] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;&#xA;INSERT INTO [dbo].[DimRecenzija]&#xA;           ([review_id]&#xA;           ,[review_comment_title]&#xA;           ,[review_comment_message]&#xA;           ,[review_creation_date])&#xA;     VALUES&#xA;           (-1&#xA;           ,'No title'&#xA;           ,'No comment'&#xA;           ,NULL)&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
