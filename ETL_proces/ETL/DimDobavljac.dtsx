          SQLTask:SqlStatementSource="IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS&#xA;&#x9;WHERE CONSTRAINT_NAME = 'FK_FactsPorudžbine_DimDobavljac')&#xA;BEGIN&#xA;&#x9;ALTER TABLE [dbo].[FactsPorudžbine] DROP CONSTRAINT [FK_FactsPorudžbine_DimDobavljac]&#xA;END&#xA;&#xA;IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM sysobjects&#xA;&#x9;WHERE id = OBJECT_ID(N'DimDobavljac'))&#xA;BEGIN&#xA;&#x9;DROP TABLE [dbo].[DimDobavljac]&#xA;&#x9;&#xA;&#x9;CREATE TABLE [dbo].[DimDobavljac](&#xA;&#x9;[seller_sid] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[seller_id] [nvarchar](50) NOT NULL,&#xA;&#x9;[seller_zip_code_prefix] [int] NOT NULL,&#xA;&#x9;[seller_city] [nvarchar](50) NOT NULL,&#xA;&#x9;[seller_state] [nvarchar](50) NOT NULL,&#xA; CONSTRAINT [PK_DimDobavljac] PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[seller_sid] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
